{
  "azphalt": "0.1",
  "id": "com.hereliesaz.azphalt.rsvp-delivery",
  "name": "RSVP Delivery",
  "version": "1.2.0",
  "kind": "asset",
  "license": "LicenseRef-Proprietary",
  "compat": ">=0.1",
  "description": "Shows one word at a time in the same spot, a second each — rapid serial visual presentation, for reading without moving your eyes.",
  "author": "HereLiesAz",
  "targetApps": [
    "com.hereliesaz.guillotine"
  ],
  "assets": [
    {
      "type": "motion",
      "path": "assets/preset.json",
      "params": {
        "format": "az-motion",
        "stagger": 1,
        "staggerMode": "word"
      },
      "tags": [
        "kinetic-typography",
        "caption",
        "word",
        "paper-inspired",
        "rsvp"
      ]
    }
  ]
}
